# Configuración del fleet para los presets de IA (Claude Code + Codex).
# install.sh copia este archivo a ~/.config/ai-presets/fleet.env; edita esa copia.
# Cada valor respeta lo que ya esté exportado en el entorno.

# Raíz donde viven los clones de los proyectos del fleet.
export FLEET_PROJECTS_ROOT="${FLEET_PROJECTS_ROOT:-$HOME/webapps}"

# Clon del toolkit de operación (scripts, projects.yml, workflows).
export OPS_ROOT="${OPS_ROOT:-$FLEET_PROJECTS_ROOT/vps-ops-toolkit}"

# Usuario de los VPS para `tailscale ssh <usuario>@<host>`.
export FLEET_SSH_USER="${FLEET_SSH_USER:-ryzepeck}"

# Raíz de proyectos en los VPS; si existe en esta máquina, dev-up/dev-down se niegan a correr.
export FLEET_VPS_ROOT="${FLEET_VPS_ROOT:-/home/$FLEET_SSH_USER/webapps}"

# hostname=alias de los VPS del fleet, separados por coma (lo usa tailscale-connect).
export FLEET_HOST_ALIASES="${FLEET_HOST_ALIASES:-srv571894=vps-projectapp-staging,srv1681495=vps-projectapp-prod,srv614758=vps-gym}"
